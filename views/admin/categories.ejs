<div class="card">
  <div class="card-header">
    <h2>分类管理 <span class="muted">(<%= categories.length %> 个)</span></h2>
    <button type="button" class="btn btn-primary btn-sm" data-action="add-category"><i class="fa fa-plus"></i> 添加分类</button>
  </div>

  <% if (categories.length > 0) { %>
    <table class="table">
      <thead><tr><th>分类名</th><th style="width:110px;">文章数</th><th style="width:200px;">操作</th></tr></thead>
      <tbody>
        <% categories.forEach(function(c) { %>
          <tr>
            <td><strong><%= c.name %></strong></td>
            <td><%= c.count %> 篇</td>
            <td class="actions">
              <button type="button" class="btn btn-sm btn-outline" data-action="rename-category" data-name="<%= c.name %>">重命名</button>
              <form method="POST" action="/admin/categories/delete" class="inline-form"
                    data-confirm="确定删除分类「<%= c.name %>」？该分类下 <%= c.count %> 篇文章将变为未分类。">
                <input type="hidden" name="cat" value="<%= c.name %>">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state" style="text-align:center;padding:30px;color:#999;">还没有分类</div>
  <% } %>
</div>

<style>
  .muted { color: #999; font-weight: normal; font-size: 0.85em; }
  .inline-form { display: inline; }
</style>

<script>
(function () {
  'use strict';

  function submit(action, fields) {
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = action;
    Object.keys(fields).forEach(function (name) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = fields[name];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-action]');
    if (!button) return;
    event.preventDefault();

    if (button.dataset.action === 'rename-category') {
      var oldName = button.dataset.name;
      var newName = prompt('将「' + oldName + '」重命名为：', oldName);
      if (!newName || newName.trim() === oldName) return;
      submit('/admin/categories/rename', { old: oldName, new: newName.trim() });
    } else if (button.dataset.action === 'add-category') {
      var cat = prompt('输入分类名称：');
      if (!cat || !cat.trim()) return;
      submit('/admin/categories/add', { cat: cat.trim() });
    }
  });

  document.addEventListener('submit', function (event) {
    var form = event.target.closest('form[data-confirm]');
    if (form && !confirm(form.dataset.confirm)) event.preventDefault();
  });
})();
</script>
