<%
var isEdit = typeof post !== 'undefined' && post.slug;
var today = new Date().toISOString().slice(0, 10);
var formDate = isEdit && post.date ? formatDate(post.date) : today;
var formTime = isEdit && post.time ? post.time : '';
var formTags = isEdit && post.tags ? post.tags.join(', ') : '';
%>

<div class="card">
  <div class="card-header">
    <h2><%= isEdit ? '编辑文章' : '新建文章' %></h2>
    <div style="display:flex;gap:8px;">
      <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('fileUpload').click()">
        <i class="fa fa-upload"></i> 上传 MD
      </button>
      <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('imgUpload').click()">
        <i class="fa fa-image"></i> 上传图片
      </button>
      <a href="/admin/posts" class="btn btn-outline btn-sm">&larr; 返回列表</a>
    </div>
  </div>

  <form method="POST" action="<%= isEdit ? '/admin/posts/edit/' + post.slug : '/admin/posts/new' %>" id="postForm">
    <!-- Hidden file inputs -->
    <input type="file" id="fileUpload" accept=".md,.txt,.markdown" style="display:none;" onchange="handleFileUpload(this)">
    <input type="file" id="imgUpload" accept="image/*" style="display:none;" onchange="handleImageUpload(this)">

    <div class="form-row">
      <div class="form-group">
        <label>标题 *</label>
        <input type="text" name="title" id="formTitle" class="form-input" value="<%= isEdit ? post.title : '' %>" required placeholder="文章标题">
      </div>
      <div class="form-group" style="max-width:130px;">
        <label>日期</label>
        <input type="date" name="date" id="formDate" class="form-input" value="<%= formDate %>">
      </div>
      <div class="form-group" style="max-width:100px;">
        <label>时间</label>
        <input type="time" name="time" id="formTime" class="form-input" value="<%= formTime %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>分类</label>
        <input type="text" name="category" id="formCategory" class="form-input" value="<%= isEdit ? (post.category || '') : '' %>" placeholder="如：开发技术" list="cat-list">
        <datalist id="cat-list">
          <% if (typeof categories !== 'undefined') { %>
            <% categories.forEach(function(c) { %><option value="<%= c.name %>"><% }) %>
          <% } %>
        </datalist>
      </div>
      <div class="form-group">
        <label>标签（逗号分隔）</label>
        <input type="text" name="tags" id="formTags" class="form-input" value="<%= formTags %>" placeholder="如：AI, Agent, 编程">
      </div>
    </div>

    <div class="form-group">
    <div class="form-group">
      <label>简述（首页展示） <span class="form-hint" style="display:inline;">— 显示在首页卡片中</span></label>
      <input type="text" name="summary" id="formSummary" class="form-input" value="<%= isEdit ? (post.summary || '') : '' %>" placeholder="留空则自动取正文前200字">
    </div>

    <div class="form-group">
      <label>摘要（文章顶部） <span class="form-hint" style="display:inline;">— 显示在文章页标题下方</span></label>
      <input type="text" name="excerpt" id="formExcerpt" class="form-input" value="<%= isEdit ? (post.excerpt || '') : '' %>" placeholder="可选，文章的引导语或摘要">
    </div>

    <div class="form-group">
      <label>正文（Markdown 格式）</label>
      <textarea name="body" id="formBody" class="form-textarea" rows="20" placeholder="使用 Markdown 格式编写文章..."><%= isEdit ? post.body : '' %></textarea>
    </div>

    <div style="display:flex;align-items:center;gap:12px;padding-top:12px;border-top:1px solid #eee;">
      <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> <%= isEdit ? '保存修改' : '发布文章' %></button>
      <button type="button" class="btn btn-outline" onclick="previewPost()"><i class="fa fa-eye"></i> 预览</button>
      <a href="/admin/posts" class="btn btn-outline">取消</a>
      <% if (isEdit) { %>
        <span style="margin-left:auto;font-size:0.82em;color:#999;">slug: <%= post.slug %></span>
      <% } %>
    </div>
  </form>
</div>

<!-- Preview Modal -->
<div class="preview-overlay" id="previewOverlay" onclick="if(event.target===this)closePreview()">
  <div class="preview-modal">
    <div class="preview-header">
      <h3>文章预览</h3>
      <button class="preview-close" onclick="closePreview()">&times;</button>
    </div>
    <div class="preview-body" id="previewBody">
      <div class="preview-loading">加载预览中...</div>
    </div>
  </div>
</div>

<style>
.preview-overlay {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6); z-index: 9999; justify-content: center; align-items: flex-start;
  padding: 40px 20px; overflow-y: auto;
}
.preview-overlay.active { display: flex; }
.preview-modal {
  background: #fff; border-radius: 10px; width: 100%; max-width: 800px;
  box-shadow: 0 12px 48px rgba(0,0,0,0.2); overflow: hidden;
}
.preview-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 24px; border-bottom: 1px solid #eee; background: #fafafa;
}
.preview-header h3 { margin: 0; font-size: 1.1em; }
.preview-close {
  background: none; border: none; font-size: 1.6em; cursor: pointer;
  color: #999; line-height: 1; padding: 0 4px;
}
.preview-close:hover { color: #333; }
.preview-body {
  padding: 30px;
  font-family: Lato, "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 2; color: #333;
}
.preview-body h1 { font-size: 1.6em; margin: 20px 0 15px; }
.preview-body h2 { font-size: 1.4em; margin: 20px 0 15px; }
.preview-body h3 { font-size: 1.2em; }
.preview-body p { margin: 0 0 18px; }
.preview-body pre { background: #f7f7f7; border: 1px solid #e5e5e5; border-radius: 4px; padding: 15px; overflow: auto; line-height: 1.6; }
.preview-body code { background: #f5f5f5; border-radius: 3px; padding: 2px 5px; color: #c7254e; font-size: 0.9em; }
.preview-body pre code { background: none; color: #333; padding: 0; }
.preview-body blockquote { border-left: 4px solid #ddd; color: #666; padding: 0 15px; margin: 0 0 18px; }
.preview-body img { max-width: 100%; }
.preview-body table { border-collapse: collapse; width: 100%; margin-bottom: 18px; }
.preview-body th, .preview-body td { border: 1px solid #ddd; padding: 8px 12px; }
.preview-body th { background: #f5f5f5; }
.preview-loading { text-align: center; color: #999; padding: 40px; }
.preview-title-display { font-size: 1.8em; font-weight: bold; margin-bottom: 8px; border-bottom: 1px solid #eee; padding-bottom: 15px; }
.preview-meta-display { color: #999; font-size: 0.85em; margin-bottom: 25px; }
</style>

<script>
// File upload — parse markdown frontmatter and fill form
function handleFileUpload(input) {
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    var content = e.target.result;
    var fmMatch = content.match(/^---\s*\n([\s\S]*?)\n---\s*\n([\s\S]*)$/);
    if (fmMatch) {
      var fmText = fmMatch[1];
      var body = fmMatch[2].trim();
      var meta = {};
      fmText.split('\n').forEach(function(line) {
        var idx = line.indexOf(':');
        if (idx === -1) return;
        var key = line.slice(0, idx).trim();
        var val = line.slice(idx + 1).trim();
        if (val.startsWith('[') && val.endsWith(']')) {
          val = val.slice(1, -1).split(',').map(function(s){return s.trim();}).join(', ');
        }
        meta[key] = val;
      });
      if (meta.title) document.getElementById('formTitle').value = meta.title;
      if (meta.date) document.getElementById('formDate').value = meta.date;
      if (meta.time) document.getElementById('formTime').value = meta.time;
      if (meta.category) document.getElementById('formCategory').value = meta.category;
      if (meta.tags) document.getElementById('formTags').value = meta.tags;
      if (meta.summary) document.getElementById('formSummary').value = meta.summary;
      if (meta.excerpt) document.getElementById('formExcerpt').value = meta.excerpt;
      document.getElementById('formBody').value = body;
    } else {
      // No frontmatter: try to use filename as title
      var title = file.name.replace(/\.(md|txt|markdown)$/, '');
      document.getElementById('formTitle').value = title;
      document.getElementById('formBody').value = content;
    }
  };
  reader.readAsText(file);
  input.value = '';
}

// Image upload
function handleImageUpload(input) {
  var file = input.files[0];
  if (!file) return;
  if (file.size > 10 * 1024 * 1024) { alert('图片不能超过 10MB'); return; }
  var reader = new FileReader();
  reader.onload = function(e) {
    var textarea = document.getElementById('formBody');
    var loading = '[上传中...]';
    textarea.value += loading;

    fetch('/api/upload-image', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: e.target.result, name: file.name })
    })
      .then(function(r) { return r.json(); })
      .then(function(result) {
        var mdImg = '![' + (file.name || 'image') + '](' + result.url + ')';
        textarea.value = textarea.value.replace(loading, mdImg);
      })
      .catch(function() {
        textarea.value = textarea.value.replace(loading, '');
        alert('上传失败');
      });
  };
  reader.readAsDataURL(file);
  input.value = '';
}

// Preview — send markdown to server for rendering
function previewPost() {
  var title = document.getElementById('formTitle').value || '未命名';
  var date = document.getElementById('formDate').value;
  var category = document.getElementById('formCategory').value;
  var body = document.getElementById('formBody').value;

  var overlay = document.getElementById('previewOverlay');
  var previewBody = document.getElementById('previewBody');
  overlay.classList.add('active');
  previewBody.innerHTML = '<div class="preview-loading">加载预览中...</div>';
  document.body.style.overflow = 'hidden';

  fetch('/api/preview', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'body=' + encodeURIComponent(body)
  })
    .then(function(r) { return r.text(); })
    .then(function(html) {
      var metaHtml = '';
      if (title) metaHtml += '<div class="preview-title-display">' + escapeHtml(title) + '</div>';
      if (date || category) {
        metaHtml += '<div class="preview-meta-display">';
        if (date) metaHtml += '<span><i class="far fa-calendar"></i> ' + date + '</span> ';
        if (category) metaHtml += '<span><i class="far fa-folder"></i> ' + escapeHtml(category) + '</span>';
        metaHtml += '</div>';
      }
      previewBody.innerHTML = metaHtml + html;
    })
    .catch(function() {
      previewBody.innerHTML = '<div class="preview-loading" style="color:#c33;">预览加载失败</div>';
    });
}

function closePreview() {
  document.getElementById('previewOverlay').classList.remove('active');
  document.body.style.overflow = '';
}

function escapeHtml(s) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ESC to close preview
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closePreview();
});
</script>
