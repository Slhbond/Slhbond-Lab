<div class="card">
  <div class="card-header">
    <h2>标签管理 <span class="muted">(<%= tags.length %> 个)</span></h2>
    <button type="button" class="btn btn-primary btn-sm" data-action="add-tag"><i class="fa fa-plus"></i> 添加标签</button>
  </div>

  <% if (tags.length > 0) { %>
    <table class="table">
      <thead><tr><th>标签名</th><th style="width:110px;">文章数</th><th style="width:200px;">操作</th></tr></thead>
      <tbody>
        <% tags.forEach(function(t) { %>
          <tr>
            <td><span class="tag-badge" style="font-size:1em;padding:3px 12px;"><%= t.name %></span></td>
            <td><%= t.count %> 篇</td>
            <td class="actions">
              <button type="button" class="btn btn-sm btn-outline" data-action="rename-tag" data-name="<%= t.name %>">重命名</button>
              <form method="POST" action="/admin/tags/delete" class="inline-form"
                    data-confirm="确定删除标签「<%= t.name %>」？将从 <%= t.count %> 篇文章中移除此标签。">
                <input type="hidden" name="tag" value="<%= t.name %>">
                <button type="submit" class="btn btn-sm btn-danger">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div class="empty-state" style="text-align:center;padding:30px;color:#999;">还没有标签，写文章时填写即可创建</div>
  <% } %>
</div>

<style>
  .muted { color: #999; font-weight: normal; font-size: 0.85em; }
  .inline-form { display: inline; }
</style>

<script>
(function () {
  'use strict';

  function submit(action, fields) {
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = action;
    Object.keys(fields).forEach(function (name) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = name;
      input.value = fields[name];
      form.appendChild(input);
    });
    document.body.appendChild(form);
    form.submit();
  }

  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-action]');
    if (!button) return;
    event.preventDefault();

    if (button.dataset.action === 'rename-tag') {
      var oldName = button.dataset.name;
      var newName = prompt('将「' + oldName + '」重命名为：', oldName);
      if (!newName || newName.trim() === oldName) return;
      submit('/admin/tags/rename', { old: oldName, new: newName.trim() });
    } else if (button.dataset.action === 'add-tag') {
      var tag = prompt('输入标签名：');
      if (!tag || !tag.trim()) return;
      submit('/admin/tags/add', { tag: tag.trim(), slug: '' });
    }
  });

  document.addEventListener('submit', function (event) {
    var form = event.target.closest('form[data-confirm]');
    if (form && !confirm(form.dataset.confirm)) event.preventDefault();
  });
})();
</script>
