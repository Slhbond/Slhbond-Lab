<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-num"><%= totalPosts %></div>
    <div class="stat-label">文章总数</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= categories.length %></div>
    <div class="stat-label">分类数</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= tags.length %></div>
    <div class="stat-label">标签数</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= typeof monthCount !== 'undefined' ? monthCount : recentPosts.length %></div>
    <div class="stat-label">本月新增</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= typeof totalWords !== 'undefined' ? totalWords : 0 %></div>
    <div class="stat-label">总字数</div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2>最近文章</h2>
    <a href="/admin/posts" class="btn btn-outline btn-sm">管理全部</a>
  </div>
  <table class="table">
    <thead><tr><th>标题</th><th>日期</th><th>分类</th><th>标签</th></tr></thead>
    <tbody>
      <% if (recentPosts.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:#999;padding:24px;">还没有文章，点右上角「写文章」开始</td></tr>
      <% } %>
      <% recentPosts.slice(0, 8).forEach(function(p) { %>
        <tr>
          <td><a href="/post/<%= p.slug %>/" target="_blank"><%= p.title %></a></td>
          <td style="white-space:nowrap;color:#999;font-size:0.85em;"><%= p.date ? formatDate(p.date) : '-' %></td>
          <td><%= p.category || '-' %></td>
          <td>
            <% (p.tags || []).forEach(function(t) { %><span class="tag-badge"><%= t %></span><% }) %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card">
  <div class="card-header"><h2>快捷操作</h2></div>
  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    <a href="/admin/posts/new" class="btn btn-primary"><i class="fa fa-plus"></i> 写文章</a>
    <a href="/admin/tags" class="btn btn-outline"><i class="fa fa-tags"></i> 管理标签</a>
    <a href="/admin/about" class="btn btn-outline"><i class="fa fa-user"></i> 编辑关于页</a>
    <a href="/admin/settings" class="btn btn-outline"><i class="fa fa-cog"></i> 站点设置</a>
    <a href="/" target="_blank" class="btn btn-outline"><i class="fa fa-eye"></i> 查看网站</a>
  </div>
</div>
