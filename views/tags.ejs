<!-- Tags page — tag cloud + filtered posts -->
<%
title = activeTag ? '标签: ' + activeTag : '标签';
var maxCount = 0, minCount = Infinity;
tags.forEach(function(t) {
  if (t.count > maxCount) maxCount = t.count;
  if (t.count < minCount) minCount = t.count;
});
if (minCount === Infinity) minCount = 1;

function tagStyle(count) {
  // font-size: 12px ~ 24px
  var ratio = maxCount > minCount ? (count - minCount) / (maxCount - minCount) : 0.5;
  var size = Math.round(12 + ratio * 12);
  // color: #ccc (light) ~ #111 (dark)
  var gray = Math.round(204 - ratio * 153); // 204→51
  var hex = gray.toString(16);
  if (hex.length === 1) hex = '0' + hex;
  return 'font-size: ' + size + 'px; color: #' + hex + hex + hex;
}
%>

<div class="tags-page">
  <div class="page-header">
    <h1 class="page-title"><%= activeTag ? '标签: ' + activeTag : '标签' %></h1>
    <p class="page-subtitle">共 <%= tags.length %> 个标签</p>
  </div>

  <!-- Tag cloud — inline styled like NexT -->
  <div class="tag-cloud-wrap">
    <% tags.forEach(function(t) { %>
      <a href="/tags/<%= encodeURIComponent(t.name) %>/" style="<%= tagStyle(t.count) %>" class="tag-cloud-link <%= activeTag === t.name ? 'active' : '' %>">
        #<%= t.name %>#
      </a>
    <% }) %>
  </div>

  <!-- Filtered posts -->
  <% if (activeTag && posts.length > 0) { %>
    <div class="tag-posts" style="margin-top:40px;">
      <h2 style="font-size:1.1em;margin-bottom:15px;color:#555;">包含标签「<%= activeTag %>」的文章</h2>
      <ul class="archive-list">
        <% posts.forEach(function(post) { %>
          <li class="archive-item">
            <span class="archive-item-date"><%= formatDate(post.date) %></span>
            <a href="/post/<%= post.slug %>/" class="archive-item-title"><%= post.title %></a>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } else if (activeTag) { %>
    <div class="empty-state">
      <p>没有包含标签「<%= activeTag %>」的文章</p>
    </div>
  <% } %>
</div>
