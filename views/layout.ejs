<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#f5f7f9">
  <meta name="description" content="<%= config.description %>">
  <meta property="og:type" content="<%= typeof post !== 'undefined' ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : config.title %>">
  <meta property="og:url" content="<%= config.url || '' %><%= currentPath %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:description" content="<%= typeof post !== 'undefined' ? (post.summary || post.title) : config.description %>">
  <meta property="article:author" content="<%= config.author %>">
  <title><%= typeof title !== 'undefined' ? title + ' | ' + config.title : config.title %></title>

  <% var assetVer = typeof assetVersion === 'string' ? assetVersion : '1'; %>
  <link rel="icon" href="/favicon.svg?v=<%= assetVer %>" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVer %>">
  <link rel="stylesheet" href="/css/layout.css?v=<%= assetVer %>">
</head>
<body itemscope itemtype="http://schema.org/WebPage">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="topbar-brand" href="/" rel="start">
        <span class="topbar-title"><%= config.title %></span>
        <% if (config.subtitle) { %><span class="topbar-subtitle"><%= config.subtitle %></span><% } %>
      </a>

      <nav class="topnav" id="topNav" aria-label="站点导航">
        <ul>
          <% Object.entries(config.menu).forEach(function(pair) {
               var item = pair[1];
               var active = (item.path === '/' && currentPath === '/') || (item.path !== '/' && currentPath.indexOf(item.path) === 0);
          %>
            <li><a href="<%= item.path %>" class="<%= active ? 'active' : '' %>"><%= item.label %></a></li>
          <% }); %>
        </ul>
      </nav>

      <div class="topbar-actions">
        <button type="button" class="icon-btn js-search-trigger" aria-label="搜索" title="搜索">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </button>
        <button type="button" class="icon-btn nav-toggle" id="navToggle" aria-label="切换导航" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <div class="site-shell">
    <main class="main<%= currentPath === '/' ? ' main-home' : '' %>">
      <div class="content">
        <%- body %>
      </div>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <div class="copyright">
          &copy; <span itemprop="copyrightYear"><%= new Date().getFullYear() %></span>
          <span class="author" itemprop="copyrightHolder"><%= config.author %></span>
          <span class="site-version"><a href="/changelog/">v<%= version %></a></span>
        </div>
        <div class="powered-by">
          由 <a href="https://nodejs.org/" target="_blank" rel="noopener">Node.js</a> &amp; <a href="https://expressjs.com/" target="_blank" rel="noopener">Express</a> 驱动
        </div>
      </div>
    </footer>
  </div>

  <div class="search-popup" id="searchPopup">
    <div class="search-popup-mask" onclick="toggleSearch()"></div>
    <div class="search-popup-inner">
      <div class="search-input-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
        <input type="text" id="searchInput" class="search-input" placeholder="搜索文章..." autocomplete="off" oninput="doSearch(this.value)">
        <button type="button" class="search-close" onclick="toggleSearch()" aria-label="关闭搜索">&times;</button>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-hint">输入关键词搜索文章标题、标签、内容...</div>
      </div>
    </div>
  </div>

  <% if (typeof post !== 'undefined') { %>
    <button type="button" class="read-progress" id="readProgress" aria-label="阅读进度，点击回到顶部" title="回到顶部">
      <span class="read-inner">
        <span class="read-percent" id="readPercent">0%</span>
        <span class="read-arrow" aria-hidden="true">↑</span>
      </span>
    </button>
  <% } %>

  <script>
    // ── 顶部导航（移动端折叠）────────────────────────────
    (function () {
      var toggle = document.getElementById('navToggle');
      var nav = document.getElementById('topNav');
      if (!toggle || !nav) return;
      toggle.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      nav.addEventListener('click', function (event) {
        if (event.target.closest('a[href]')) {
          nav.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    })();

    // ── 搜索 ──────────────────────────────────────────────
    var searchData = [];
    var searchLoading = false;

    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function loadSearchData() {
      if (searchLoading) return Promise.resolve();
      searchLoading = true;
      return fetch('/search.json', { cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('HTTP ' + r.status);
          return r.json();
        })
        .then(function (data) { searchData = Array.isArray(data) ? data : []; })
        .catch(function () { searchData = []; })
        .then(function () { searchLoading = false; });
    }

    function toggleSearch() {
      var popup = document.getElementById('searchPopup');
      var isOpen = popup.classList.contains('active');
      if (isOpen) {
        popup.classList.remove('active');
        document.body.style.overflow = '';
      } else {
        popup.classList.add('active');
        document.body.style.overflow = 'hidden';
        document.getElementById('searchResults').innerHTML =
          '<div class="search-hint">正在加载搜索数据...</div>';
        loadSearchData().then(function () {
          var input = document.getElementById('searchInput');
          if (input.value.trim()) doSearch(input.value);
          else document.getElementById('searchResults').innerHTML =
            '<div class="search-hint">输入关键词搜索文章标题、标签、内容...</div>';
        });
        setTimeout(function () { document.getElementById('searchInput').focus(); }, 100);
      }
    }

    function makeSnippet(post, query) {
      var source = String(post.summary || '') + ' ' + String(post.text || '');
      var index = source.toLowerCase().indexOf(query);
      if (index === -1) return '';
      var start = Math.max(0, index - 36);
      var end = Math.min(source.length, index + query.length + 64);
      return (start > 0 ? '…' : '') + source.slice(start, end).trim() + (end < source.length ? '…' : '');
    }

    function highlightText(text, query) {
      if (!query) return text;
      var source = String(text);
      var lower = source.toLowerCase();
      var q = query.toLowerCase();
      var out = '';
      var from = 0;
      while (from < source.length) {
        var found = lower.indexOf(q, from);
        if (found === -1) { out += source.slice(from); break; }
        out += source.slice(from, found) + '<mark>' + source.slice(found, found + q.length) + '</mark>';
        from = found + q.length;
      }
      return out;
    }

    function doSearch(query) {
      var container = document.getElementById('searchResults');
      if (!query || query.trim().length < 1) {
        container.innerHTML = '<div class="search-hint">输入关键词搜索文章标题、标签、内容...</div>';
        return;
      }
      if (searchLoading) {
        container.innerHTML = '<div class="search-hint">正在加载搜索数据...</div>';
        return;
      }

      var q = query.toLowerCase().trim();
      var results = [];
      searchData.forEach(function (post) {
        var score = 0;
        var title = (post.title || '').toLowerCase();
        var category = (post.category || '').toLowerCase();
        var summary = (post.summary || '') + ' ' + (post.excerpt || '');
        var text = (post.text || '').toLowerCase();
        var titleMatch = title.indexOf(q);
        if (titleMatch !== -1) score += 100 - Math.min(titleMatch, 40);
        (post.tags || []).forEach(function (tag) {
          if (tag.toLowerCase().indexOf(q) !== -1) score += 50;
        });
        if (category.indexOf(q) !== -1) score += 30;
        var textIdx = text.indexOf(q);
        if (textIdx !== -1) score += 10 - Math.min(textIdx / 100, 5);
        if (summary.toLowerCase().indexOf(q) !== -1) score += 15;
        if (score > 0) results.push({ post: post, score: score });
      });

      results.sort(function (a, b) { return b.score - a.score; });

      if (results.length === 0) {
        container.innerHTML = '<div class="search-no-results">没有找到匹配的文章</div>';
        return;
      }

      var html = '';
      results.slice(0, 15).forEach(function (r) {
        var p = r.post;
        var snippet = makeSnippet(p, q);
        html += '<a href="/post/' + encodeURIComponent(p.slug) + '" class="search-result-item">'
          + '<div class="search-result-title">' + highlightText(escapeHtml(p.title), q) + '</div>'
          + (snippet ? '<div class="search-result-snippet">' + highlightText(escapeHtml(snippet), q) + '</div>' : '')
          + '<div class="search-result-meta">'
          + '<span><i class="far fa-calendar"></i> ' + escapeHtml(p.date) + '</span>'
          + (p.category ? '<span><i class="far fa-folder"></i> ' + escapeHtml(p.category) + '</span>' : '')
          + '</div></a>';
      });
      container.innerHTML = html;
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var popup = document.getElementById('searchPopup');
        if (popup && popup.classList.contains('active')) toggleSearch();
      }
    });

    // ── 阅读进度 / 回到顶部 / 右侧目录高亮 ────────────────
    (function () {
      var btn = document.getElementById('readProgress');
      var pctEl = document.getElementById('readPercent');
      var article = document.querySelector('.post-page');
      var tocLinks = Array.prototype.slice.call(document.querySelectorAll('.toc-rail a'));

      function onScroll() {
        var scroll = window.scrollY || document.documentElement.scrollTop;
        if (btn && article && pctEl) {
          var top = article.getBoundingClientRect().top + scroll;
          var range = article.offsetHeight - window.innerHeight + 160;
          var pct = range > 0 ? Math.round((scroll - top + 120) / range * 100) : 100;
          pct = Math.max(0, Math.min(100, pct));
          pctEl.textContent = pct + '%';
          btn.style.background = 'conic-gradient(#222 ' + pct + '%, #e5e5e5 0)';
        }
        if (tocLinks.length) {
          var active = 0;
          tocLinks.forEach(function (link, i) {
            var id = decodeURIComponent((link.getAttribute('href') || '').slice(1));
            var head = document.getElementById(id);
            if (!head) return;
            if (head.getBoundingClientRect().top <= 120) active = i;
          });
          tocLinks.forEach(function (link, i) { link.classList.toggle('active', i === active); });
        }
      }

      if (btn) {
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();

    // ── 代码复制 ─────────────────────────────────────────
    function copyCode(btn) {
      var fig = btn.closest('figure.highlight');
      var code = fig.querySelector('td.code code');
      if (!code) return;
      var lines = code.querySelectorAll('.line');
      var text = '';
      lines.forEach(function (l) { text += (l.textContent || l.innerText) + '\n'; });

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () { showCopied(btn); }).catch(function () { fallbackCopy(text, btn); });
      } else {
        fallbackCopy(text, btn);
      }
    }

    function fallbackCopy(text, btn) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); showCopied(btn); } catch (e) { /* ignore */ }
      document.body.removeChild(ta);
    }

    function showCopied(btn) {
      var label = btn.querySelector('.copy-label');
      btn.classList.add('copied');
      if (label) label.textContent = '已复制';
      setTimeout(function () {
        btn.classList.remove('copied');
        if (label) label.textContent = '复制';
      }, 1500);
    }

    document.querySelectorAll('.js-search-trigger').forEach(function (el) {
      el.addEventListener('click', function (event) {
        if (el.tagName === 'A') event.preventDefault();
        toggleSearch();
      });
    });
  </script>
</body>
</html>